# Prefer PHP entry points (nginx/Apache may otherwise serve legacy .html)
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Legacy HTML bookmarks → PHP
RewriteRule ^contact\.html$ contact.php [L,R=301]
RewriteRule ^services\.html$ services.php [L,R=301]
RewriteRule ^about\.html$ about.php [L,R=301]
RewriteRule ^index\.html$ index.php [L,R=301]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php83" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
